# The publication's Quarto project.
#
# This file lives in report/ rather than at the repo root, and deliberately.
# At the root, Quarto's default render set sweeps up every markdown file it
# finds -- README.md, CHANGELOG.md, notes, plans -- none of which is the
# publication, all of which it would render and rewrite. An isolated project
# directory with an explicit render target keeps the render to the one document
# that is the publication.
project:
  type: default
  render:
    - report.qmd

# A floor, not an exact pin. Pin the exact Quarto build in your environment
# (a Nix flake, a container image, or a documented install step) the way
# uv.lock pins your Python dependencies; this floor is the check that survives
# someone rendering by hand with whatever `quarto` resolves on their PATH.
#
# Two Quarto builds reporting the same version are not necessarily the same
# toolchain -- they can ship different Pandoc versions, and one may render gfm
# but die on HTML. A version floor cannot catch that; only naming the exact
# build can. Record how yours is pinned alongside this file.
required-version: ">=1.5"

# Generated by `python -m {{PROJECT_NAME_UNDERSCORE}}.report_bib` (or your
# pipeline's bib stage) from a source registry and the download manifest, so a
# citation's retrieval time and checksum come from the download rather than
# from a footnote someone keeps in step by hand -- which is how reference lists
# go stale.
#
# citeproc does NOT fail a render on a key it cannot find. It warns, prints
# `**the-key?**` into the document, and exits zero. tests/test_citations.py is
# therefore the only guard against a mistyped key, and it runs before anything
# is rendered.
bibliography: references.bib
csl: numeric-provenance.csl

# Numbered references under their own heading.
citeproc: true
link-citations: true

# -smart stops Pandoc rewriting every apostrophe and dash into its typographic
# form on the way in. The publication is prose a person wrote; the characters
# it was written with are the ones it should keep. Set as a reader option here
# so both output formats read the source identically.
from: markdown-smart

format:
  # Two formats, read by different audiences.
  #
  # gfm is what every check reads: the tests parse it and the review diff reads
  # it. It is the format committed to git, so review of a data refresh stays a
  # plain git diff rather than a re-render of a binary.
  gfm:
    output-file: report.md

    # Keep the source's line breaks rather than reflowing to a column. Without
    # this, a data refresh that changed one figure would rewrap every paragraph
    # around it, turning a one-number change into a diff where every line moved
    # and none of it meant anything. This is what keeps review honest.
    wrap: preserve

  # HTML is the format a statistical publication ought to be published in, and
  # what a reader outside this repository would be handed.
  html:
    output-file: report.html

    # The browser tab, the bookmark, and the preview card wherever this file is
    # shared. `pagetitle` rather than `title`: `title` renders a Quarto title
    # block above the document's own H1, duplicating it, and lands in the gfm
    # output the tests parse and the review diff reads. This sets the HTML head
    # alone and leaves both documents as they are.
    pagetitle: "{{PROJECT_NAME}}"

    # One file, no sidecar. Without this, Quarto writes CSS and JS into a
    # `_files/` directory beside the output and links figures by relative path,
    # so the artifact is a tree that only works in place. With it, the HTML is a
    # single self-contained file carrying every figure inline -- one file a
    # reader can be sent.
    embed-resources: true

# Let the data pipeline, not Quarto, decide whether the document is stale.
# Quarto's freeze cache watches the document; your pipeline watches the data.
# Only one may decide whether a render is out of date, and it should be the one
# that sees a data refresh.
execute:
  freeze: false
